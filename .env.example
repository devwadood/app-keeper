# Public application
NEXT_PUBLIC_APP_NAME=AppLedger
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-openssl-rand-base64-48
CRON_SECRET=replace-with-openssl-rand-hex-32
TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
TOKEN_ENCRYPTION_KEY_VERSION=v1

# Neon / Payload
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=
MIGRATION_DATABASE_URL=

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v20
GOOGLE_OAUTH_SCOPES_BASE=openid email profile

# Email / files / jobs
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=AppLedger
EMAIL_MODE=console
BLOB_READ_WRITE_TOKEN=
JOB_DRIVER=database
VERCEL_QUEUE_REGION=
VERCEL_QUEUE_TOPIC_PREFIX=appledger
CRON_TIMEZONE=UTC
VERCEL_ENV=
VERCEL_URL=

# Security / operations
LOG_LEVEL=info
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SUPPORT_EMAIL=
SEED_PLATFORM_ADMIN_EMAIL=
SEED_PLATFORM_ADMIN_PASSWORD=
SEED_DEMO_DATA=true
